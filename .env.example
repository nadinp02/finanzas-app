# Copiá este archivo a .env y completá los valores. Nunca subas .env al repositorio.

# PostgreSQL. Local sin Docker: `npm run db:dev` levanta uno en el puerto 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/finanzas"

# Transcripción de audio (OpenAI, pago por uso). Crear en https://platform.openai.com/api-keys
# Opcional: sin esta clave se dicta gratis con el reconocimiento de voz del navegador.
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Interpretación de lo dictado (Anthropic, pago por uso: aparte de la suscripción a Claude).
# Crear en https://platform.claude.com/ — Opcional: sin esta clave se usa el intérprete local por
# reglas, gratis (siempre pide revisión).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5   # claude-haiku-5-5: más barato y rápido

# Quién interpreta: auto (Claude si hay clave; si no, local), anthropic, openai o local.
# VOICE_INTERPRETER=auto
# OPENAI_INTERPRETER_MODEL=gpt-6-luna   # solo con VOICE_INTERPRETER=openai

# Cron diario en Vercel (opcional): genera recurrentes y limpia sesiones vencidas.
CRON_SECRET=

# Emails de recuperación de contraseña (ver docs/DEPLOY.md). Brevo es gratis y no exige dominio propio:
# alcanza con verificar la dirección del remitente. Sin clave, en desarrollo el email se muestra en la
# consola; en producción no se envía.
BREVO_API_KEY=
# RESEND_API_KEY=            # alternativa: requiere un dominio propio verificado
EMAIL_FROM=
# URL pública para los enlaces de los emails. En Vercel no hace falta (se usa el dominio de producción).
# APP_URL=https://tu-proyecto.vercel.app

# Solo para pruebas automatizadas: transcripción falsa sin llamar a OpenAI.
# VOICE_STT_PROVIDER=fake
# VOICE_FAKE_TRANSCRIPT="Nafta cincuenta mil, supermercado treinta y dos mil"
# Solo para pruebas automatizadas: los emails se escriben en este archivo en vez de enviarse.
# EMAIL_OUTBOX_FILE=.data/outbox.jsonl
