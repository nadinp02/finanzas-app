{
  "name": "finanzas-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && serwist build",
    "vercel-build": "prisma migrate deploy && npm run build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p src/worker",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "user:create": "tsx --conditions=react-server scripts/create-user.ts",
    "user:reset-password": "tsx --conditions=react-server scripts/reset-password.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "postinstall": "prisma generate",
    "voice:check": "tsx --conditions=react-server scripts/voice-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "7.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "idb": "8.0.4",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@serwist/cli": "^9.5.13",
    "@serwist/next": "^9.5.13",
    "@tailwindcss/turbopack": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "6.2.7",
    "jsdom": "^27.4.0",
    "prisma": "7.10.1",
    "serwist": "9.5.13",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
